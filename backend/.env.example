# Copy this file to .env and replace every placeholder with your own value.
# Never commit .env or put real credentials in this file.

# Server Config
SERVER_PORT=3000

# MongoDB Configuration (Cloud/Atlas)
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER_NAME=your_cluster_name
MONGODB_CLUSTER_ID=your_cluster_id
MONGODB_DATABASE=CogniScript

# ChromaDB Configuration
CHROMA_DB_PATH=./chromaDB

# LLM Provider Configuration
# Options: Perplexity, OpenAI, Gemini, Groq, Anthropic
LLM_PROVIDER=Groq

# LLM API Keys
PERPLEXITY_API_KEY=your_perplexity_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# RAG Configuration
MAX_RAG_RESULTS=10
MAX_CHAT_HISTORY=10
MAX_CONTEXT_TOKENS=8000
CHAT_MEMORY_TOKEN_LIMIT=2000

# Optional: only needed if a hosted Hugging Face service is used.
# Local sentence-transformers embeddings do not require this token.
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token
